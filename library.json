{
  "name": "TinyRTCM3",
  "version": "0.1.0",
  "description": "Compact RTCM 3 frame assemble/CRC/decode/encode for ESP32 RTK pipelines. v0.1: CRC-24Q compute/verify/append/finalizeFrame + assembler + hub; 1005/1033/MSM codec APIs are Unsupported stubs; CI uses synthetic goldens only.",
  "keywords": "rtcm, gnss, rtk, ntrip, crc24q, esp32",
  "repository": {
    "type": "git",
    "url": "https://github.com/bnorth12/TinyRTCM3.git"
  },
  "authors": [
    {
      "name": "Brian",
      "url": "https://github.com/bnorth12",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/bnorth12/TinyRTCM3",
  "frameworks": "arduino",
  "platforms": "*",
  "headers": "TinyRTCM3.h",
  "export": {
    "include": [
      "src/*",
      "examples/*",
      "library.properties",
      "keywords.txt",
      "LICENSE",
      "README.md"
    ],
    "exclude": [
      "raw",
      "test/golden/field",
      "scripts",
      "docs"
    ]
  },
  "examples": [
    {
      "name": "PassThroughHub",
      "base": "examples/PassThroughHub",
      "files": ["PassThroughHub.ino"]
    }
  ]
}

